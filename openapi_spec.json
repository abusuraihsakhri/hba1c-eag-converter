{
  "openapi": "3.1.0",
  "info": {
    "title": "HbA1c to eAG Converter API",
    "description": "Stateless HbA1c/eAG conversion and optional prototype audit operations.",
    "version": "3.0.0",
    "contact": {
      "name": "Dr. Abu Suraih Sakhri",
      "url": "https://github.com/abusuraihsakhri"
    }
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health and metadata check",
        "responses": {
          "200": {
            "description": "System optimal"
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "summary": "In-memory processed dossier and audit counts",
        "responses": {
          "200": {
            "description": "Prometheus text metrics"
          }
        }
      }
    },
    "/api/audit": {
      "post": {
        "summary": "Dispatch task payload across specialized workers",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "task_id": {
                    "type": "string"
                  },
                  "target_identifier": {
                    "type": "string"
                  },
                  "primary_metric": {
                    "type": "number"
                  },
                  "secondary_metric": {
                    "type": "number"
                  },
                  "status_descriptor": {
                    "type": "string"
                  },
                  "is_critical_flag": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "task_id",
                  "target_identifier",
                  "primary_metric"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Consensus dossier with HMAC signature"
          }
        }
      }
    },
    "/api/chat": {
      "post": {
        "summary": "Deterministic mock supervisor response (not medical advice)",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "query": {
                    "type": "string"
                  }
                },
                "required": [
                  "query"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Supervisory response"
          }
        }
      }
    },
    "/api/audit/logs": {
      "get": {
        "summary": "Retrieve HMAC audit trail (requires configured bearer token)",
        "responses": {
          "200": {
            "description": "Cryptographic audit trail"
          },
          "403": {
            "description": "Audit logs are protected or token is not configured"
          }
        }
      }
    },
    "/api/convert": {
      "post": {
        "summary": "Stateless HbA1c/eAG/IFCC conversion",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "hba1c_percent": {
                    "type": "number",
                    "description": "HbA1c NGSP %"
                  },
                  "eag_mgdl": {
                    "type": "number",
                    "description": "Estimated average glucose mg/dL"
                  },
                  "eag_mmol": {
                    "type": "number",
                    "description": "Estimated average glucose mmol/L"
                  },
                  "ifcc_mmol": {
                    "type": "number",
                    "description": "HbA1c IFCC mmol/mol"
                  }
                },
                "description": "Supply exactly one value."
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "All four converted values"
          },
          "422": {
            "description": "Invalid measurement, range, or source count"
          }
        }
      }
    }
  }
}
